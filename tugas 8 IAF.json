    {
      "parameters": {
        "jsCode": "// Inisialisasi variabel penghitung\nlet total_tweets = items.length;\nlet positive = 0;\nlet negative = 0;\nlet neutral = 0;\n\n// Loop melalui setiap item data masuk\nfor (let item of items) {\n    let sentiment = item.json.status;\n    \n    // Sesuaikan pencocokan dengan teks bahasa Indonesia (\"Positif\")\n    if (sentiment === 'Positif') {\n        positive++;\n    } else if (sentiment === 'Negatif') {\n        negative++;\n    } else if (sentiment === 'Netral' || sentiment === 'Neutral') {\n        neutral++;\n    }\n}\n\n// Kembalikan hasil perhitungan ke n8n\nreturn items.map(item => {\n    return {\n        json: {\n            total_tweets: total_tweets,\n            sentimen_positif: positive,\n            sentimen_negatif: negative,\n            sentimen_netral: neutral,\n            // Jika ingin meneruskan data asli juga\n            timestamp: item.json.timestamp,\n            text: item.json.text,\n            status: item.json.status\n        }\n    };\n});"
      },
